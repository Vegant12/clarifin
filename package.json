{
  "name": "clarifin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs",
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx scripts/eval/run.ts",
    "ta:seed": "tsx scripts/ta/seed-and-backfill.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/db/database.types.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "1.2.22",
    "@ai-sdk/groq": "1.2.9",
    "@google/genai": "^1.52.0",
    "@supabase/supabase-js": "^2.105.1",
    "@t3-oss/env-nextjs": "^0.11.1",
    "ai": "4.3.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "langfuse": "^3.38.20",
    "lightweight-charts": "5.2.0",
    "lucide-react": "^1.14.0",
    "next": "^15.5.15",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^9.1.0",
    "react-pdf": "^10.4.1",
    "react-resizable-panels": "^4.11.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "technicalindicators": "3.1.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.6.2",
    "yahoo-finance2": "^3.14.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv": "^16.6.1",
    "jsdom": "^29.1.1",
    "server-only": "^0.0.1",
    "supabase": "^2.100.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  }
}
