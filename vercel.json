{
  "crons": [
    {
      "path": "/api/internal/parse-batch?secret=${INTERNAL_PARSE_SECRET}",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/embed-batch?secret=${INTERNAL_PARSE_SECRET}",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 0 * * 0"
    }
  ]
}
