# ─── Supabase (server-side, never expose) ──────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Supabase (browser-safe) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─── Google Gemini (server-side, never expose) ─────────────────────
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Internal ingestion (server-only) ────────────────────────────
# Min 32 characters. Used by Vercel Cron + next/server after() → /api/internal/parse-batch
# In Vercel: set the Cron job URL to /api/internal/parse-batch?secret=<same value>
# (Cron requests are GET by default; this project accepts GET with ?secret= or POST with Bearer).
INTERNAL_PARSE_SECRET=01234567890123456789012345678901

# Optional: base URL for server-side fetch to this app (else VERCEL_URL or http://localhost:3000)
# CLARIFIN_APP_URL=https://your-deployment.vercel.app

# ─── Optional ──────────────────────────────────────────────────────
# Set to "true" in CI to skip env validation (e.g., for build-only checks)
# SKIP_ENV_VALIDATION=
#
# Simulate pipeline transitions locally (Parsing → Embedding → Analyzing) for Phase 2 UI
# STUB_PIPELINE_TICK=true
