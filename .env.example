# ─── Supabase (server-side, never expose) ──────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Supabase (browser-safe) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─── Google Gemini (server-side, never expose) ─────────────────────
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# ─── Internal ingestion (server-only) ────────────────────────────
# Min 32 characters. Used by next/server after() to call internal batch routes.
# Generate with: openssl rand -hex 32
INTERNAL_PARSE_SECRET=<generate-with: openssl rand -hex 32>

# ─── Vercel Cron authentication ──────────────────────────────────
# Vercel automatically sends "Authorization: Bearer <CRON_SECRET>" on all
# cron requests. Set this to the SAME value as INTERNAL_PARSE_SECRET so the
# existing Bearer auth in /api/internal/parse-batch and embed-batch accepts it.
# Set in Vercel dashboard → Project Settings → Environment Variables.
CRON_SECRET=<same-value-as-INTERNAL_PARSE_SECRET>

# ─── App URL (optional) ──────────────────────────────────────────
# Used for server-side fetch in API routes. Defaults to VERCEL_URL when deployed.
# Only needed locally if server routes call each other.
# CLARIFIN_APP_URL=http://localhost:3000

# ─── Langfuse observability ──────────────────────────────────────
# Get keys from https://cloud.langfuse.com → Project Settings → API Keys
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # uncomment only if self-hosting

# ─── Optional ──────────────────────────────────────────────────────
# Set to "true" in CI to skip env validation (e.g., for build-only checks)
# SKIP_ENV_VALIDATION=
#
# Simulate pipeline transitions locally (Parsing → Embedding → Analyzing) for Phase 2 UI
# STUB_PIPELINE_TICK=true
