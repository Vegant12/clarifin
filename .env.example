# ─── Supabase (server-side, never expose) ──────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Supabase (browser-safe) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ─── Google Gemini (server-side, never expose) ─────────────────────
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# ─── Internal ingestion (server-only) ────────────────────────────
# Min 32 characters. Used by Vercel Cron + next/server after() → /api/internal/parse-batch
# In Vercel: set BOTH cron job URLs to include this secret query param:
#   /api/internal/parse-batch?secret=<INTERNAL_PARSE_SECRET>
#   /api/internal/embed-batch?secret=<INTERNAL_PARSE_SECRET>
# (Cron requests are GET by default; this project accepts GET with ?secret= or POST with Bearer).
INTERNAL_PARSE_SECRET=<generate-with: openssl rand -hex 32>

# Optional Phase 5 eval gate tuning (developer harness)
# EVAL_MIN_NUMERIC_PCT=90
# EVAL_MIN_CITATION_PCT=90
# EVAL_PROMPT_VARIANT=broken   # forces degraded prompt to prove sub-threshold scoring (dev only)

# Langfuse observability (Phase 11) — get keys from https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com   # uncomment only if self-hosting

# ─── Optional ──────────────────────────────────────────────────────
# Set to "true" in CI to skip env validation (e.g., for build-only checks)
# SKIP_ENV_VALIDATION=
#
# Simulate pipeline transitions locally (Parsing → Embedding → Analyzing) for Phase 2 UI
# STUB_PIPELINE_TICK=true
